    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/web-bluetooth": "^0.0.20",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.0",
    "fake-indexeddb": "^6.2.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "patch-package": "^8.0.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.4.1"
